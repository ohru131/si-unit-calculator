# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# RevenueCat Public SDK Keys (safe to embed in the client bundle; NOT the Secret API key)
# https://app.revenuecat.com/ -> Project settings -> API keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# AdMob App IDs (used by app.config.ts at build/prebuild time). Falls back to Google's
# public test App IDs when unset, so a normal dev build never ships without a valid ID.
# https://apps.admob.com/ -> App settings -> App ID
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# AdMob banner ad unit ID shown on the free tier. Falls back to Google's test banner unit
# (react-native-google-mobile-ads TestIds.BANNER) when unset.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=

# Personal code to unlock the ad-free experience locally without a real purchase
# (Settings -> Ads -> Enter a code). Keep this out of source control; anything starting
# with EXPO_PUBLIC_ is bundled into the client, so treat it as convenience, not security.
EXPO_PUBLIC_ADFREE_REDEEM_CODE=
